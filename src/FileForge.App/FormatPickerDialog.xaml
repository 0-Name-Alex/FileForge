<Window x:Class="FileForge.App.FormatPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Target Format"
        Width="580" Height="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        PreviewKeyDown="OnWindowKeyDown">

  <Border Margin="16" CornerRadius="12" Padding="18"
          BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
          Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.4" Direction="270" />
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ── HEADER ── -->
      <DockPanel Grid.Row="0" Margin="2,0,0,12">
        <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Click="OnCloseClick" ToolTip="Close (Esc)">
          <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" />
        </Button>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="16"
                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Select Output Format" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>

      <!-- ── SEARCH BOX ── -->
      <Grid Grid.Row="1" Margin="2,0,2,10">
        <Border CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource LayerFillColorAltBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
          <TextBox x:Name="SearchBox" FontSize="14" Padding="36,8,12,8"
                   TextChanged="OnSearchTextChanged"
                   Background="Transparent" BorderThickness="0" />
        </Border>
        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="12,0,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" IsHitTestVisible="False" />
        <TextBlock x:Name="SearchPlaceholder" Text="Type to filter formats (e.g. pdf, webp, csv, xlsx, docx, zip)..."
                   FontSize="13" Margin="38,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Opacity="0.6" VerticalAlignment="Center" IsHitTestVisible="False" />
      </Grid>

      <!-- ── CATEGORY FILTER CHIPS ── -->
      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="2,0,2,10">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="CatAll" Content="All Formats" IsChecked="True" Checked="OnCategoryChanged" Margin="0,0,6,0" Style="{StaticResource CategoryChip}" />
          <RadioButton x:Name="CatDocs" Content="Documents &amp; Slides" Checked="OnCategoryChanged" Margin="0,0,6,0" Style="{StaticResource CategoryChip}" />
          <RadioButton x:Name="CatImages" Content="Images" Checked="OnCategoryChanged" Margin="0,0,6,0" Style="{StaticResource CategoryChip}" />
          <RadioButton x:Name="CatData" Content="Data &amp; Sheets" Checked="OnCategoryChanged" Margin="0,0,6,0" Style="{StaticResource CategoryChip}" />
          <RadioButton x:Name="CatArchives" Content="Archives" Checked="OnCategoryChanged" Margin="0,0,6,0" Style="{StaticResource CategoryChip}" />
          <RadioButton x:Name="CatDev" Content="Developer &amp; Hashes" Checked="OnCategoryChanged" Margin="0,0,0,0" Style="{StaticResource CategoryChip}" />
        </StackPanel>
      </ScrollViewer>

      <!-- ── FORMAT ITEMS LIST ── -->
      <ListBox Grid.Row="3" x:Name="FormatsList"
               Margin="2,0,2,8"
               BorderThickness="0" Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               VirtualizingPanel.ScrollUnit="Pixel"
               MouseDoubleClick="OnFormatDoubleClick"
               ItemContainerStyle="{StaticResource FormatRowItem}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Padding="10,8" Margin="0,2" CornerRadius="6" Background="Transparent">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon and Extension badge -->
                <Border Grid.Column="0" CornerRadius="6" Padding="8,4" MinWidth="48"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ExtensionUpper}" FontSize="12" FontWeight="Bold"
                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                             HorizontalAlignment="Center" />
                </Border>

                <!-- Name and Description -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,10,0">
                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Category pill -->
                <Border Grid.Column="2" Style="{StaticResource CountBadge}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding CategoryName}" FontSize="11" Opacity="0.75" />
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- ── FOOTER ── -->
      <DockPanel Grid.Row="4" Margin="4,4,2,0">
        <TextBlock Text="↑↓ choose · Enter select · Esc close" Style="{StaticResource Caption}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource SubtleBtn}" Content="Cancel" Click="OnCloseClick" Margin="0,0,8,0" />
          <Button Style="{StaticResource AccentBtn}" Content="Select Format" Click="OnSelectClick" />
        </StackPanel>
      </DockPanel>
    </Grid>
  </Border>
</Window>
