<Window x:Class="FileForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileForge.App.ViewModels"
        Title="FileForge"
        Icon="assets/app_icon.png"
        Width="960" Height="640" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        AllowDrop="True" Drop="OnFileDrop" DragOver="OnDragOver">

  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding AddFilesCommand}" />
    <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding AddFolderCommand}" />
  </Window.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ═══════════ HEADER BAR ═══════════ -->
    <Border Grid.Row="0" Padding="16,12,16,10"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
            Background="{DynamicResource LayerFillColorAltBrush}">
      <DockPanel>
        <!-- Right side: actions -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource IconBtn}" Command="{Binding TrimMemoryCommand}" ToolTip="Trim memory">
            <TextBlock Text="&#xECA7;" FontFamily="{StaticResource IconFont}" FontSize="14" />
          </Button>
        </StackPanel>

        <!-- Left side: branding -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="assets/app_icon.png" Width="26" Height="26" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="FileForge" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
          <TextBlock Text="Universal File Converter" Style="{StaticResource Caption}" Margin="12,2,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ═══════════ MAIN CONTENT ═══════════ -->
    <Grid Grid.Row="1" Margin="20,16,20,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ── DROP ZONE ── -->
      <Border x:Name="DropZone" Grid.Row="0" CornerRadius="10" Padding="24,20"
              Background="Transparent"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1.5" Cursor="Hand"
              MouseLeftButtonUp="OnDropZoneClick">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="&#xED25;" FontFamily="{StaticResource IconFont}" FontSize="28"
                     HorizontalAlignment="Center" Opacity="0.5" />
          <TextBlock Text="Drop files or folders here to convert" FontSize="14"
                     HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.7" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button Style="{StaticResource SubtleBtn}" Command="{Binding AddFilesCommand}" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="Browse Files" Margin="6,0,0,0" FontSize="12" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource SubtleBtn}" Command="{Binding AddFolderCommand}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xED43;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="Browse Folder" Margin="6,0,0,0" FontSize="12" />
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Text="Ctrl+O files · Ctrl+D folder · Ctrl+Alt+F quick launcher"
                     Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <!-- ── TOOLBAR ── -->
      <DockPanel Grid.Row="1" Margin="0,14,0,6">
        <!-- Right: clear actions -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource IconBtn}" Command="{Binding ClearCompletedCommand}" ToolTip="Clear completed">
            <TextBlock Text="&#xEE47;" FontFamily="{StaticResource IconFont}" FontSize="13" />
          </Button>
          <Button Style="{StaticResource IconBtn}" Command="{Binding ClearAllCommand}" ToolTip="Clear all">
            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" />
          </Button>
        </StackPanel>

        <!-- Left: batch target actions -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Batch Queue" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />

          <Border Style="{StaticResource CountBadge}" Margin="10,0,0,0">
            <TextBlock FontSize="11" HorizontalAlignment="Center" Opacity="0.85">
              <TextBlock.Text>
                <MultiBinding StringFormat="{}{0} files">
                  <Binding Path="TotalItems" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </Border>

          <Border Height="18" Width="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="14,0" VerticalAlignment="Center" />

          <TextBlock Text="Set all to:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox ItemsSource="{Binding CommonTargetPresets}"
                    SelectedItem="{Binding CommonTargetFormat}"
                    IsEditable="True" IsTextSearchEnabled="True"
                    Width="85" VerticalAlignment="Center" />
          <Button Style="{StaticResource IconBtn}" Click="OnOpenBatchFormatPickerClick" ToolTip="Search and browse all output formats" Margin="4,0,0,0">
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" />
          </Button>
          <Button Style="{StaticResource SubtleBtn}" Command="{Binding ApplyTargetToAllCommand}"
                  Margin="6,0,0,0" ToolTip="Apply to all items in queue">
            <TextBlock Text="Apply" FontSize="12" />
          </Button>
        </StackPanel>
      </DockPanel>

      <!-- ── FILE QUEUE LIST ── -->
      <ListBox Grid.Row="2" x:Name="QueueList"
               ItemsSource="{Binding QueueItems}"
               HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingPanel.ScrollUnit="Pixel"
               BorderThickness="0" Background="Transparent"
               ItemContainerStyle="{StaticResource QueueItem}"
               SelectionMode="Extended">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ConversionItemViewModel}">
            <Border Padding="10,8" Background="Transparent">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- File info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{Binding FileName}" FontSize="13" TextTrimming="CharacterEllipsis" />
                  <WrapPanel Margin="0,2,0,0">
                    <TextBlock Style="{StaticResource Caption}">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} · {1}">
                          <Binding Path="DetectedFormat" />
                          <Binding Path="FormattedSize" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </WrapPanel>
                  <TextBlock Text="{Binding ErrorMessage}" Foreground="#E5484D" FontSize="11"
                             TextWrapping="Wrap" Margin="0,3,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Status}" Value="Failed">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>

                <!-- Arrow -->
                <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="12"
                           VerticalAlignment="Center" Opacity="0.4" Margin="0,0,10,0" />

                <!-- Target format dropdown with search button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                  <ComboBox Width="80" VerticalAlignment="Center"
                            IsEditable="True" IsTextSearchEnabled="True"
                            ItemsSource="{Binding AvailableTargetFormats}"
                            SelectedItem="{Binding TargetFormat, Mode=TwoWay}" />
                  <Button Style="{StaticResource IconBtn}" Click="OnOpenRowFormatPickerClick" ToolTip="Search and browse formats" Margin="2,0,0,0">
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                  </Button>
                </StackPanel>

                <!-- Status / progress -->
                <Border Grid.Column="3" Width="115" VerticalAlignment="Center" Margin="0,0,6,0">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusLabel" Text="{Binding StatusMessage}" FontSize="11" Opacity="0.75"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                      <TextBlock.ToolTip>
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" MaxWidth="360" />
                      </TextBlock.ToolTip>
                    </TextBlock>
                    <!-- Progress bar (shown below label ONLY while processing so it never overlaps Done/Failed) -->
                    <Border CornerRadius="2" ClipToBounds="True" Margin="0,4,0,0">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Processing">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    </Border>
                  </StackPanel>
                </Border>

                <!-- Row actions -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource IconBtn}" Command="{Binding OpenOutputFolderCommand}" ToolTip="Show in Explorer">
                    <TextBlock Text="&#xED25;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Status}" Value="Completed">
                <Setter TargetName="StatusLabel" Property="Foreground" Value="#40A02B" />
                <Setter TargetName="StatusLabel" Property="Opacity" Value="0.9" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="Failed">
                <Setter TargetName="StatusLabel" Property="Foreground" Value="#E5484D" />
                <Setter TargetName="StatusLabel" Property="Opacity" Value="0.9" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="Processing">
                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <Setter TargetName="StatusLabel" Property="Opacity" Value="1" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- ── EMPTY STATE ── -->
      <TextBlock Grid.Row="2" Text="No files in queue. Drop files above or press Ctrl+O."
                 FontSize="13" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding QueueItems.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <!-- ── OUTPUT SETTINGS + CONVERT BUTTON ── -->
      <Border Grid.Row="3" Margin="0,10,0,0" Padding="12,10" CornerRadius="8"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <DockPanel>
          <!-- Right: big convert / cancel button -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource SubtleBtn}" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="Cancel" Margin="6,0,0,0" FontSize="12" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource SubtleBtn}" Command="{Binding MergeToPdfCommand}" Margin="0,0,8,0"
                    ToolTip="Merge queue files (PDFs, Images, PPTX) into a single consolidated PDF">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEA90;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Margin="6,0,0,0" FontSize="12" Text="Merge to PDF" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource AccentBtn}" Command="{Binding ConvertAllCommand}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"
                           Foreground="White" />
                <TextBlock Foreground="White" Margin="8,0,0,0" FontSize="13">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="Convert All ({0})">
                      <Binding Path="TotalItems" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Left: output path + change / open folder -->
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xED43;" FontFamily="{StaticResource IconFont}" FontSize="12"
                         VerticalAlignment="Center" Opacity="0.6" />
              <TextBlock Text="Output:" Style="{StaticResource Caption}" Margin="6,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding OutputDirectory}" FontSize="12" Opacity="0.75" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" MaxWidth="340" ToolTip="{Binding OutputDirectory}" />
              <Button Style="{StaticResource SubtleBtn}" Command="{Binding ChangeOutputFolderCommand}"
                      ToolTip="Choose output folder location" Margin="8,0,0,0" Padding="8,3">
                <TextBlock Text="Change..." FontSize="11" />
              </Button>
              <Button Style="{StaticResource IconBtn}" Command="{Binding OpenOutputFolderCommand}" ToolTip="Open output folder" Margin="4,0,0,0">
                <TextBlock Text="&#xE8DA;" FontFamily="{StaticResource IconFont}" FontSize="11" />
              </Button>
            </StackPanel>

            <!-- Progress bar -->
            <Border CornerRadius="2" ClipToBounds="True" Margin="0,8,0,0">
              <ProgressBar Value="{Binding OverallProgress}" Maximum="100" Height="3"
                           Foreground="{DynamicResource AccentFillColorDefaultBrush}">
                <ProgressBar.Style>
                  <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsBusy}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ProgressBar.Style>
              </ProgressBar>
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Bottom spacing -->
      <Border Grid.Row="4" Height="6" />
    </Grid>

    <!-- ═══════════ STATUS BAR ═══════════ -->
    <Border Grid.Row="2" Padding="16,6" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            Background="{DynamicResource LayerFillColorAltBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
            <TextBlock.Text>
              <MultiBinding StringFormat="{}{0:F1} MB">
                <Binding Path="CurrentMemoryMb" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
          <Border Height="12" Width="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="10,0" VerticalAlignment="Center" />
          <TextBlock Text="Ctrl+Alt+F quick launcher" Style="{StaticResource Caption}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Left: status text with result badges -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="#40A02B" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.75" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" MaxWidth="500" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
