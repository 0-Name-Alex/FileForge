<Window x:Class="FileForge.App.QuickLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileForge Quick Launcher"
        Icon="assets/app_icon.png"
        Width="520" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        AllowDrop="True" Drop="OnQuickDrop" DragOver="OnQuickDragOver"
        PreviewKeyDown="OnKeyDown">

  <Border x:Name="Root" Margin="18" CornerRadius="12" Padding="14"
          BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
          Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.35" Direction="270" />
    </Border.Effect>

    <StackPanel>
      <!-- Header row -->
      <DockPanel Margin="2,0,0,10">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource SubtleBtn}" Command="{Binding OpenMainAppCommand}"
                  ToolTip="Open full FileForge window" Padding="10,4" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Text="Open Main App" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <TextBlock Text="Esc to close" FontSize="11" Opacity="0.4" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="assets/app_icon.png" Width="20" Height="20" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="FileForge Quick Convert" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>

      <!-- Drop zone -->
      <Border x:Name="QuickDropZone" CornerRadius="10" Padding="20,24" Margin="0,0,0,10"
              BorderThickness="1.5" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnQuickDropZoneClick">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </Border.Style>

        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="&#xED25;" FontFamily="{StaticResource IconFont}" FontSize="24"
                     HorizontalAlignment="Center" Opacity="0.45" />
          <TextBlock Text="Drop files here to quickly convert" FontSize="13"
                     HorizontalAlignment="Center" Margin="0,6,0,0" Opacity="0.65" />
        </StackPanel>
      </Border>

      <!-- Target format + Output folder row -->
      <DockPanel Margin="2,0,2,6">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Output:" FontSize="11" Opacity="0.55" VerticalAlignment="Center" Margin="0,0,4,0" />
          <TextBlock Text="{Binding OutputDirectory}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"
                     MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputDirectory}" />
          <Button Style="{StaticResource SubtleBtn}" Command="{Binding ChangeOutputFolderCommand}"
                  ToolTip="Change output folder" Margin="6,0,0,0" Padding="7,2">
            <TextBlock Text="Change..." FontSize="11" />
          </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Convert to:" FontSize="12" Opacity="0.65" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding TargetFormats}"
                    SelectedItem="{Binding SelectedTargetFormat, Mode=TwoWay}"
                    Width="90" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>

      <!-- Status (wraps on errors so failure reasons stay readable) -->
      <TextBlock Text="{Binding StatusMessage}" FontSize="12" Opacity="0.75" Margin="2,2,2,4"
                 TextWrapping="Wrap" />

      <!-- Footer -->
      <TextBlock FontSize="11" Opacity="0.35" Margin="2,2,0,0"
                 Text="Ctrl+Alt+F toggle · Drop files or click to browse" />
    </StackPanel>
  </Border>
</Window>
